{
  "name": "cdmon-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server and CLI for deploying files and running SQL on cdmon hosting",
  "license": "Apache-2.0",
  "author": "Blai Peidro",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cdmon-mcp": "dist/index.js",
    "cdmon": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpusProjects/cdmon-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/OpusProjects/cdmon-mcp/issues"
  },
  "homepage": "https://github.com/OpusProjects/cdmon-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cdmon",
    "shared-hosting",
    "ftp",
    "phpmyadmin",
    "deployment"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "testserver:up": "docker compose -f tests/testserver/docker-compose.yml up -d --wait",
    "testserver:down": "docker compose -f tests/testserver/docker-compose.yml down -v",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "basic-ftp": "^6.2.0",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
