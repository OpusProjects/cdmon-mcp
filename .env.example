# Copy to .env and fill in. Never commit the result.
#
# The MCP server reads these from its client's `env` block rather than from tool
# arguments, so the model never sees them and cannot repeat them into a transcript.

# --- FTP -------------------------------------------------------------------
CDMON_FTP_HOST=ftp.example.com
CDMON_FTP_USER=your-ftp-user
CDMON_FTP_PASS=your-ftp-password

# Everything the server writes or deletes is resolved inside this directory.
# A path that escapes it is refused rather than clamped.
CDMON_FTP_ROOT=/

# Milliseconds to pause after every FTP operation, successful or not. cdmon
# blocks an address that connects too quickly, and an agent will happily issue
# twenty uploads in a row.
CDMON_FTP_DELAY_MS=2000

# Use FTPS. Left off because not every cdmon plan accepts it; turn it on if
# yours does, since the alternative sends the password in the clear.
CDMON_FTP_SECURE=0

# --- phpMyAdmin ------------------------------------------------------------
CDMON_PMA_URL=https://phpmyadmin.example.com
CDMON_PMA_USER=your-database-user
CDMON_PMA_PASS=your-database-password
CDMON_PMA_DB=your_database

# --- Safety ----------------------------------------------------------------
# Off by default. Without it the server exposes reads only: no upload, no
# delete, no INSERT/UPDATE/DELETE/DDL.
CDMON_ALLOW_WRITES=0

# Where the append-only record of every write is kept.
CDMON_AUDIT_LOG=./cdmon-audit.log
